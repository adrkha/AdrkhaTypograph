<UserControl x:Class="AdrkhaTypograph.TypoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             FlowDirection="RightToLeft"
             d:DesignHeight="600" d:DesignWidth="300"
             FontFamily="IBM Plex Sans Arabic, Segoe UI, Tahoma, Arial">
    
    <UserControl.Resources>
        <!-- Dynamic Brushes mapped to dynamic colors updated in code-behind -->
        <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{DynamicResource ThemeBackgroundColor}"/>
        <SolidColorBrush x:Key="ThemeForegroundBrush" Color="{DynamicResource ThemeForegroundColor}"/>
        <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="{DynamicResource ThemeCardBackgroundColor}"/>
        <SolidColorBrush x:Key="ThemeTextBoxBackgroundBrush" Color="{DynamicResource ThemeTextBoxBackgroundColor}"/>
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="{DynamicResource ThemeBorderBrushColor}"/>
        <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="{DynamicResource ThemeTextMutedColor}"/>
        <SolidColorBrush x:Key="ThemeHighlightBrush" Color="{DynamicResource ThemeHighlightColor}"/>
        <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="{DynamicResource PreviewBackgroundColor}"/>

        <!-- Modern Scrollbar styling -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Button Flat Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Action Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0066FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A75FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0052CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio Button Style as Segmented Toggle Button -->
        <Style x:Key="AlignmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#0066FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeHighlightBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#1A75FF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Item Container Style -->
        <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboSelectedBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ComboSelectedForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Flat ComboBox Control Template -->
        <Style x:Key="FlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="{DynamicResource ThemeTextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Main Background Border -->
                            <Border Grid.ColumnSpan="2" x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>
                            
                            <!-- Content Presenter for selected item -->
                            <ContentPresenter Grid.Column="0" IsHitTestVisible="false"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            
                            <!-- Arrow Button -->
                            <ToggleButton Grid.ColumnSpan="2" x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="1" Background="Transparent" Padding="8,0">
                                                <Path x:Name="Arrow"
                                                      Data="M 0 0 L 3.5 4 L 7 0 Z"
                                                      Fill="{DynamicResource ThemeTextMutedBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#0066FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Popup -->
                            <Popup Grid.ColumnSpan="2" x:Name="PART_Popup"
                                   AllowsTransparency="true"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource ThemeCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, ElementName=Border}"
                                        Margin="0,2,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="true">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="PART_Popup" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" Value="#0066FF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" Value="#0066FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Feature CheckBox (Horizontal Chip Style) -->
        <Style x:Key="FeatureChipStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChipBorder"
                                Background="{DynamicResource ThemeCardBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10,5"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtDesc" Text="{Binding Description, Mode=OneTime}" FontSize="11" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Medium"/>
                                <Border x:Name="TagBorder" Background="{DynamicResource ThemeHighlightBrush}" CornerRadius="8" Margin="6,0,0,0" Padding="5,1.5">
                                    <TextBlock x:Name="TxtTag" Text="{Binding Tag, Mode=OneTime}" FontSize="9" Foreground="#0066FF" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#0066FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#0066FF"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#0066FF"/>
                                <Setter TargetName="TxtDesc" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="TagBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="TxtTag" Property="Foreground" Value="#0066FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ThemeBackgroundBrush}" Margin="0">
        <Grid.RowDefinitions>
            <!-- Content Wrapper -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Margin-aware Content Wrapper -->
        <Grid Margin="18,16,18,12">
            <Grid.RowDefinitions>
                <!-- Logo & Title Header -->
                <RowDefinition Height="Auto"/>
                <!-- Font Selection -->
                <RowDefinition Height="Auto"/>
                <!-- Resizable middle section -->
                <RowDefinition Height="*"/>
                <!-- Preview -->
                <RowDefinition Height="Auto"/>
                <!-- Button & Link Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo & Title Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Stylized Logo Icon -->
                <Border Width="38" Height="38" CornerRadius="8" Background="#0066FF" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="أ" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Border>
                
                <!-- Title Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ادركها تايبوجراف" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                    <TextBlock Text="تحويل خصائص الخطوط إلى تايبوجراف" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" FontWeight="Medium"/>
                </StackPanel>
            </Grid>

            <!-- Font Directory & Search Selection -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <!-- Folder Selection -->
                <TextBlock Text="مجلد الخطوط العربية:" FontSize="14" Margin="0,0,0,5" Foreground="{DynamicResource ThemeTextMutedBrush}" FontWeight="SemiBold"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource ThemeTextBoxBackgroundBrush}" Padding="1,0">
                        <TextBox x:Name="TxtFolderPath" Height="28" VerticalContentAlignment="Center" Background="Transparent" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" Padding="6,0" IsReadOnly="True" FontSize="11"/>
                    </Border>
                    <Button Grid.Column="1" Content="اختيار مجلد..." Margin="6,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="BtnBrowseFolder_Click"/>
                </Grid>
                
                <!-- Font Search & Dropdown -->
                <Grid x:Name="GridFontSelection" Visibility="Collapsed" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource ThemeTextBoxBackgroundBrush}">
                            <TextBox x:Name="TxtSearchFont" Height="28" Padding="6,4" Background="Transparent" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" FontSize="12" TextChanged="TxtSearchFont_TextChanged"/>
                        </Border>
                        <TextBlock x:Name="TxtSearchPlaceholder" IsHitTestVisible="False" Text="🔍 اكتب للبحث في الخطوط المتاحة..." FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="8,7,0,0" VerticalAlignment="Top"/>
                    </Grid>
                    <ComboBox x:Name="ComboFonts" Height="28" Style="{StaticResource FlatComboBoxStyle}" SelectionChanged="ComboFonts_SelectionChanged" FontSize="12" ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"/>
                </Grid>
            </StackPanel>

            <!-- Resizable Middle Section Grid (TextBox & Feature Chips) -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <!-- Label and Alignment Segmented Controls -->
                    <RowDefinition Height="Auto"/>
                    <!-- Expandable TextBox (MinHeight=80, Default=160) -->
                    <RowDefinition Height="160" MinHeight="80"/>
                    <!-- GridSplitter (vertical resizer) -->
                    <RowDefinition Height="8"/>
                    <!-- Features Label -->
                    <RowDefinition Height="Auto"/>
                    <!-- Dynamic WrapPanel Chips (Scrollable) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Label and Alignment -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="النص العربي المراد كتابته:" FontSize="14" Foreground="{DynamicResource ThemeTextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal" Background="{DynamicResource ThemeHighlightBrush}">
                            <RadioButton x:Name="RadAlignRight" Content=" يمين " IsChecked="True" Style="{StaticResource AlignmentRadioButtonStyle}" Checked="AlignmentButton_Checked"/>
                            <RadioButton x:Name="RadAlignCenter" Content=" وسط " Style="{StaticResource AlignmentRadioButtonStyle}" Checked="AlignmentButton_Checked"/>
                            <RadioButton x:Name="RadAlignLeft" Content=" يسار " Style="{StaticResource AlignmentRadioButtonStyle}" Checked="AlignmentButton_Checked" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Resizable Textbox (Default large height 160) -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource ThemeTextBoxBackgroundBrush}">
                    <TextBox x:Name="TxtInputText" Background="Transparent" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" Padding="8" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="TxtInputText_TextChanged" VerticalScrollBarVisibility="Auto"/>
                </Border>

                <!-- GridSplitter for TextBox vertical resizing -->
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource ThemeBorderBrush}" Cursor="SizeNS" Margin="0,1"/>

                <!-- Features Label -->
                <TextBlock Grid.Row="3" Text="ميزات الـ OpenType المتوفرة بالخط:" FontSize="14" Margin="0,25,0,6" Foreground="{DynamicResource ThemeTextMutedBrush}" FontWeight="SemiBold"/>

                <!-- Dynamic WrapPanel Chips -->
                <Border Grid.Row="4" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Notice when no features are loaded -->
                            <TextBlock x:Name="TxtNoFeatures" Text="يرجى اختيار مجلد خطوط صالح لعرض ميزات التنسيق المتوفرة فيه." FontSize="11.5" Foreground="{DynamicResource ThemeTextMutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,20,0,0" TextAlignment="Center"/>
                            
                            <!-- List of horizontal dynamic chips -->
                            <ItemsControl x:Name="FeaturesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="{Binding Tag}" Style="{StaticResource FeatureChipStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Live Preview -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="المعاينة الحية:" FontSize="12" Margin="0,0,0,5" Foreground="{DynamicResource ThemeTextMutedBrush}" FontWeight="SemiBold"/>
                <Border Grid.Row="1" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" MinHeight="90" MaxHeight="130" Padding="12" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Color="#888888" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <!-- Preview Image -->
                        <Image x:Name="ImgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Placeholder/Loading -->
                        <TextBlock x:Name="TxtPreviewPlaceholder" Text="اكتب نصاً للمعاينة..." FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Action Button & Website Link Footer -->
            <StackPanel Grid.Row="4">
                 <CheckBox x:Name="ChkInsertEditableText" Content="إدراج نص قابل للتعديل (بدون تراكيب جمالية)" FontSize="11.5" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,10"/>
                 <Button x:Name="BtnInsertUpdate" Content="إدراج في بوربوينت" Style="{StaticResource AccentButtonStyle}" Click="BtnInsertUpdate_Click"/>
                
                <!-- Footer Website Link -->
                <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="🌐" FontSize="11" Foreground="#0066FF" Margin="0,0,4,0"/>
                    <TextBlock FontSize="11" VerticalAlignment="Center">
                        <Hyperlink NavigateUri="https://powerpoint.adrkha.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#0066FF" TextDecorations="None">
                            powerpoint.adrkha.com
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
        <!-- Update Notification Banner (مخفي افتراضياً، يظهر عند توفر تحديث) -->
        <Grid x:Name="UpdateBannerGrid" Visibility="Collapsed" VerticalAlignment="Bottom">
            <Border Background="#1A3A6B" BorderBrush="#0066FF" BorderThickness="0,1,0,0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- صف المعلومات -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtUpdateMessage" Text="يتوفر تحديث جديد!" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="BtnUpdate" Content="تحديث الآن" FontSize="11" Padding="8,4" Margin="0,0,6,0"
                                    Background="#0066FF" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Click="BtnUpdate_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A75FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnDismissUpdate" Content="لاحقاً" FontSize="11" Padding="6,4"
                                    Background="Transparent" Foreground="#AAAACC" BorderThickness="0" Cursor="Hand"
                                    Click="BtnDismissUpdate_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- شريط تقدم التحميل (مخفي حتى يبدأ التحميل) -->
                    <ProgressBar x:Name="UpdateProgressBar" Grid.Row="1" Height="4" Margin="0,8,0,0"
                                 Minimum="0" Maximum="100" Value="0"
                                 Background="#0D2A5A" Foreground="#0066FF"
                                 Visibility="Collapsed"/>

                    <!-- نص التقدم -->
                    <TextBlock x:Name="TxtDownloadStatus" Grid.Row="2" FontSize="10" Foreground="#AAAACC"
                               Margin="0,4,0,0" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
